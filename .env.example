# Copiez ce fichier en .env et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS être committé (voir .gitignore).

# Port public exposé par le frontend nginx (l'app est accessible sur http://SERVEUR:PORT)
FRONTEND_PORT=8080

# Origines autorisées pour les appels API (CORS), séparées par des virgules.
# En production, indiquez l'URL publique du frontend, ex :
#   CORS_ORIGIN=https://gmq.mondomaine.fr
# Laissez vide en local/dev pour tout autoriser.
CORS_ORIGIN=

# Rendement carcasse par défaut (%) utilisé pour convertir un poids de carcasse
# en poids vif estimé (poids_vif = poids_carcasse / rendement), quand un broutard
# n'a pas de rendement propre. Valeurs proposées dans l'app : 55, 58, 60.
RENDEMENT_DEFAULT=58
